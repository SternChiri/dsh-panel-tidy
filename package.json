{
  "name": "dsh-panel-tidy",
  "version": "0.2.1",
  "type": "module",
  "description": "侧栏面板自由拖动：长按拖到任意位置排序，拖进「更多」即收纳、拖出即放回。Sidebar panel organizer for DeepSeek Harness: drag any panel to reorder, drop it into More to fold.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "panel",
    "more-menu",
    "drag-and-drop",
    "ui"
  ],
  "license": "MIT",
  "author": "SternChiri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SternChiri/dsh-panel-tidy.git"
  },
  "homepage": "https://github.com/SternChiri/dsh-panel-tidy#readme",
  "bugs": {
    "url": "https://github.com/SternChiri/dsh-panel-tidy/issues"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "test": "node test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
